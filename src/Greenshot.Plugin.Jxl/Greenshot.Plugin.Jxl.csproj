<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>Greenshot.Plugin.Jxl</RootNamespace>
    <AssemblyName>Greenshot.Plugin.Jxl</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- libjxl 0.12.0 (jxl-x64-windows.zip of https://github.com/libjxl/libjxl/releases), next to the plugin: plugins only run in the 64-bit full version -->
    <None Include="Native\x64\*.dll" Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Greenshot.Base\Greenshot.Base.csproj" />
    <ProjectReference Include="..\Greenshot.Editor\Greenshot.Editor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>
